- if (index = local_attr :index)
  sup.footnote-ref
    a [
        id=(footnoteref_id unless type == :xref)
        href="##{footnote_id}"
        title="View footnote #{index}"
        role='doc-noteref' ]
      | [#{index}]
- else
  sup.footnote-ref.broken
    a title="Unresolved footnote reference." [#{text}]
